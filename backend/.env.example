# Copy to .env and fill in what you need. Nothing is required for running on one PC / the shop network.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=Africa/Algiers

# --- Supabase (online). Database: Project Settings > Database > Connection string > Session pooler
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DB_POOLED=0
# --- Supabase photos: Storage > bucket "photos" (public) + Project Settings > Storage > S3 access keys
# SUPABASE_S3_BUCKET=photos
# SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_REGION=eu-central-1
# SUPABASE_PUBLIC_URL_HOST=<ref>.supabase.co/storage/v1/object/public/photos

# --- When the website is hosted elsewhere (Vercel/Netlify)
# CORS_ORIGINS=https://your-shop.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-shop.vercel.app
# FRONTEND_URL=https://your-shop.vercel.app
# HTTPS=1

# --- Login security
# ACCESS_MINUTES=15
# REFRESH_HOURS=12
# REMEMBER_ME_DAYS=30
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_MINUTES=15

# --- E-mail (password reset, "order ready")
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
